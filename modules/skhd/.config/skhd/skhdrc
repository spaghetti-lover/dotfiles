alt - 7 [
    "google chrome" : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 7
    "brave browser" : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 7
    "safari"        : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 7
    *               ~
]
alt - 8 [
    "google chrome" : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 8
    "brave browser" : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 8
    "safari"        : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 8
    *               ~
