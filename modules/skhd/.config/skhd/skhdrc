alt - 9 [
    "google chrome" : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 9
    "brave browser" : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 9
    "safari"        : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 9
    *               ~
]

alt + shift - 0x29 ; service

service < escape : /opt/homebrew/bin/yabai --restart-service && /opt/homebrew/bin/skhd --reload

service < q ; default

service < r         : /opt/homebrew/bin/yabai -m space --balance ; /opt/homebrew/bin/skhd -k "q"
service < f         : /opt/homebrew/bin/yabai -m window --toggle float ; /opt/homebrew/bin/skhd -k "q"
service < backspace : "$HOME/dotfiles/modules/yabai/bin/close-others.sh" ; /opt/homebrew/bin/skhd -k "q"

service < alt + shift - h : "$HOME/dotfiles/modules/yabai/bin/group-join.sh" west ; /opt/homebrew/bin/skhd -k "q"
service < alt + shift - j : "$HOME/dotfiles/modules/yabai/bin/group-join.sh" south ; /opt/homebrew/bin/skhd -k "q"
service < alt + shift - k : "$HOME/dotfiles/modules/yabai/bin/group-join.sh" north ; /opt/homebrew/bin/skhd -k "q"
service < alt + shift - l : "$HOME/dotfiles/modules/yabai/bin/group-join.sh" east ; /opt/homebrew/bin/skhd -k "q"
