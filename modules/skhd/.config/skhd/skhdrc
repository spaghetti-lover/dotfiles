cmd + shift - 0x32 : /opt/homebrew/bin/yabai -m window --space scratch
cmd + alt - s      : /opt/homebrew/bin/yabai -m window --space scratch

# Super + Shift + Alt + Arrow = move whole workspace to another monitor
