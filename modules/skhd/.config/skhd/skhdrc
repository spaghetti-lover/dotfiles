# ------------------------------------------------------- layout / window state
# On alt, not cmd: cmd-t is the browser's New Tab.
alt - t : /opt/homebrew/bin/yabai -m window --toggle float

# Omarchy's Super+O: pop this window out of the tiling tree and have it follow
# you from workspace to workspace. Press again to put it back. Unlike
# AeroSpace's aerospace-pin.sh this is a real sticky window, so there is no
# limit of one and it is drawn in place rather than flicking there afterwards.
cmd - o : /Users/ducannh/dotfiles/modules/yabai/bin/window-pop.sh

# Toggle window position: side by side <-> stacked. This is Hyprland's
# togglesplit exactly -- it flips the split of the focused node, leaving the
# rest of the tree alone. (AeroSpace had to re-orient the workspace root
# instead, because of its split-opposite rule.)
#
# Through a script, not a bare `--toggle split`: every new window here arrives
# zoomed, and the flip underneath a zoomed window is invisible. See the header
# of split-toggle.sh for the measurements.
cmd - j : /Users/ducannh/dotfiles/modules/yabai/bin/split-toggle.sh

# Per-workspace layout, remembered across restarts: bsp <-> stack, where stack
# makes the whole space one pile with a single window showing. Omarchy's
# Super+L, which flips dwindle <-> scrolling.
#
# On cmd-alt-l, not cmd-l: docs/keybindings.md leaves cmd-l as Open Location.
cmd + alt - l : /Users/ducannh/dotfiles/modules/yabai/bin/layout-memo.sh toggle

# ---------------------------------------------------------------- fullscreen
# Omarchy's plain Super+F (zoom-fullscreen) is deliberately NOT bound, so that
