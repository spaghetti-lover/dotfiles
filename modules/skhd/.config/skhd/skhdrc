cmd + ctrl - 0x18         : /opt/homebrew/bin/yabai -m window --resize right:300:0 || /opt/homebrew/bin/yabai -m window --resize left:-300:0
cmd + ctrl + shift - 0x1B : /opt/homebrew/bin/yabai -m window --resize bottom:0:-300 || /opt/homebrew/bin/yabai -m window --resize top:0:300
cmd + ctrl + shift - 0x18 : /opt/homebrew/bin/yabai -m window --resize bottom:0:300 || /opt/homebrew/bin/yabai -m window --resize top:0:-300

