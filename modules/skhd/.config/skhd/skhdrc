.blacklist [
    "tigervnc"
    "vncviewer"
]

:: default
:: service @

cmd - left  : "$HOME/dotfiles/modules/yabai/bin/focus.sh" west
cmd - down  : "$HOME/dotfiles/modules/yabai/bin/focus.sh" south
cmd - up    : "$HOME/dotfiles/modules/yabai/bin/focus.sh" north
cmd - right : "$HOME/dotfiles/modules/yabai/bin/focus.sh" east

cmd + shift - left  : /opt/homebrew/bin/yabai -m window --swap west
cmd + shift - down  : /opt/homebrew/bin/yabai -m window --swap south
cmd + shift - up    : /opt/homebrew/bin/yabai -m window --swap north
cmd + shift - right : /opt/homebrew/bin/yabai -m window --swap east

alt - tab                : "$HOME/dotfiles/modules/yabai/bin/focus.sh" next
alt + shift - tab        : "$HOME/dotfiles/modules/yabai/bin/focus.sh" prev
ctrl + alt - tab         : /opt/homebrew/bin/yabai -m display --focus next || /opt/homebrew/bin/yabai -m display --focus first
ctrl + alt + shift - tab : /opt/homebrew/bin/yabai -m display --focus prev || /opt/homebrew/bin/yabai -m display --focus last

cmd - 0x1B                : "$HOME/dotfiles/modules/yabai/bin/resize.sh" h -100
cmd - 0x18                : "$HOME/dotfiles/modules/yabai/bin/resize.sh" h 100
cmd + shift - 0x1B        : "$HOME/dotfiles/modules/yabai/bin/resize.sh" v -100
cmd + shift - 0x18        : "$HOME/dotfiles/modules/yabai/bin/resize.sh" v 100

cmd + alt - 0x1B          : "$HOME/dotfiles/modules/yabai/bin/resize.sh" h -25
cmd + alt - 0x18          : "$HOME/dotfiles/modules/yabai/bin/resize.sh" h 25
cmd + shift + alt - 0x1B  : "$HOME/dotfiles/modules/yabai/bin/resize.sh" v -25
cmd + shift + alt - 0x18  : "$HOME/dotfiles/modules/yabai/bin/resize.sh" v 25

cmd + ctrl - 0x1B         : "$HOME/dotfiles/modules/yabai/bin/resize.sh" h -300
cmd + ctrl - 0x18         : "$HOME/dotfiles/modules/yabai/bin/resize.sh" h 300
cmd + ctrl + shift - 0x1B : "$HOME/dotfiles/modules/yabai/bin/resize.sh" v -300
cmd + ctrl + shift - 0x18 : "$HOME/dotfiles/modules/yabai/bin/resize.sh" v 300

cmd - 1 : /opt/homebrew/bin/yabai -m space --focus ws1
cmd - 2 : /opt/homebrew/bin/yabai -m space --focus ws2
cmd - 3 : /opt/homebrew/bin/yabai -m space --focus ws3
cmd - 4 : /opt/homebrew/bin/yabai -m space --focus ws4
cmd - 5 : /opt/homebrew/bin/yabai -m space --focus ws5
cmd - 6 : /opt/homebrew/bin/yabai -m space --focus ws6
cmd - 7 : /opt/homebrew/bin/yabai -m space --focus ws7
cmd - 8 : /opt/homebrew/bin/yabai -m space --focus ws8
cmd - 9 : /opt/homebrew/bin/yabai -m space --focus ws9

cmd - tab              : /opt/homebrew/bin/yabai -m space --focus next || /opt/homebrew/bin/yabai -m space --focus first
cmd + shift - tab      : /opt/homebrew/bin/yabai -m space --focus prev || /opt/homebrew/bin/yabai -m space --focus last
cmd + ctrl - tab       : /opt/homebrew/bin/yabai -m space --focus recent

cmd + shift - 1 : /opt/homebrew/bin/yabai -m window --space ws1 --focus
cmd + shift - 2 : /opt/homebrew/bin/yabai -m window --space ws2 --focus
cmd + shift - 3 : /opt/homebrew/bin/yabai -m window --space ws3 --focus
cmd + shift - 4 : /opt/homebrew/bin/yabai -m window --space ws4 --focus
cmd + shift - 5 : /opt/homebrew/bin/yabai -m window --space ws5 --focus
cmd + shift - 6 : /opt/homebrew/bin/yabai -m window --space ws6 --focus
cmd + shift - 7 : /opt/homebrew/bin/yabai -m window --space ws7 --focus
cmd + shift - 8 : /opt/homebrew/bin/yabai -m window --space ws8 --focus
cmd + shift - 9 : /opt/homebrew/bin/yabai -m window --space ws9 --focus

cmd + shift + alt - 1 : /opt/homebrew/bin/yabai -m window --space ws1
cmd + shift + alt - 2 : /opt/homebrew/bin/yabai -m window --space ws2
cmd + shift + alt - 3 : /opt/homebrew/bin/yabai -m window --space ws3
cmd + shift + alt - 4 : /opt/homebrew/bin/yabai -m window --space ws4
cmd + shift + alt - 5 : /opt/homebrew/bin/yabai -m window --space ws5
cmd + shift + alt - 6 : /opt/homebrew/bin/yabai -m window --space ws6
cmd + shift + alt - 7 : /opt/homebrew/bin/yabai -m window --space ws7
cmd + shift + alt - 8 : /opt/homebrew/bin/yabai -m window --space ws8
cmd + shift + alt - 9 : /opt/homebrew/bin/yabai -m window --space ws9

cmd - 0x32         : "$HOME/dotfiles/modules/yabai/bin/scratch-toggle.sh"
cmd + shift - 0x32 : /opt/homebrew/bin/yabai -m window --space scratch
cmd + alt - s      : /opt/homebrew/bin/yabai -m window --space scratch

cmd + shift + alt - left  : /opt/homebrew/bin/yabai -m space --display west
cmd + shift + alt - down  : /opt/homebrew/bin/yabai -m space --display south
cmd + shift + alt - up    : /opt/homebrew/bin/yabai -m space --display north
cmd + shift + alt - right : /opt/homebrew/bin/yabai -m space --display east

cmd - j : "$HOME/dotfiles/modules/yabai/bin/split-toggle.sh"

cmd + ctrl - f : /opt/homebrew/bin/yabai -m window --toggle zoom-parent
cmd + alt - f  : "$HOME/dotfiles/modules/yabai/bin/fullscreen-space.sh"

cmd - g       : "$HOME/dotfiles/modules/yabai/bin/group-toggle.sh"
cmd + alt - g : "$HOME/dotfiles/modules/yabai/bin/group-eject.sh"

cmd + alt - tab         : /opt/homebrew/bin/yabai -m window --focus stack.next || /opt/homebrew/bin/yabai -m window --focus stack.first
cmd + alt + shift - tab : /opt/homebrew/bin/yabai -m window --focus stack.prev || /opt/homebrew/bin/yabai -m window --focus stack.last
cmd + ctrl - left       : /opt/homebrew/bin/yabai -m window --focus stack.prev || /opt/homebrew/bin/yabai -m window --focus stack.last
cmd + ctrl - right      : /opt/homebrew/bin/yabai -m window --focus stack.next || /opt/homebrew/bin/yabai -m window --focus stack.first

cmd + alt - left  : "$HOME/dotfiles/modules/yabai/bin/group-join.sh" west
cmd + alt - down  : "$HOME/dotfiles/modules/yabai/bin/group-join.sh" south
cmd + alt - up    : "$HOME/dotfiles/modules/yabai/bin/group-join.sh" north
cmd + alt - right : "$HOME/dotfiles/modules/yabai/bin/group-join.sh" east

cmd + alt - 1 : /opt/homebrew/bin/yabai -m window --focus stack.1 || "$HOME/dotfiles/modules/yabai/bin/focus-index.sh" 1
cmd + alt - 2 : /opt/homebrew/bin/yabai -m window --focus stack.2 || "$HOME/dotfiles/modules/yabai/bin/focus-index.sh" 2
cmd + alt - 3 : /opt/homebrew/bin/yabai -m window --focus stack.3 || "$HOME/dotfiles/modules/yabai/bin/focus-index.sh" 3
cmd + alt - 4 : /opt/homebrew/bin/yabai -m window --focus stack.4 || "$HOME/dotfiles/modules/yabai/bin/focus-index.sh" 4
cmd + alt - 5 : /opt/homebrew/bin/yabai -m window --focus stack.5 || "$HOME/dotfiles/modules/yabai/bin/focus-index.sh" 5
cmd + alt - 6 : "$HOME/dotfiles/modules/yabai/bin/focus-index.sh" 6
cmd + alt - 7 : "$HOME/dotfiles/modules/yabai/bin/focus-index.sh" 7
cmd + alt - 8 : "$HOME/dotfiles/modules/yabai/bin/focus-index.sh" 8
cmd + alt - 9 : "$HOME/dotfiles/modules/yabai/bin/focus-index.sh" 9

ctrl + alt - backspace : "$HOME/dotfiles/modules/yabai/bin/close-others.sh"

cmd - return          : open -na Ghostty
cmd + alt - return    : open -na Ghostty --args -e /opt/homebrew/bin/tmux new-session -A -s main
cmd + shift - return  : open -na "Google Chrome"
cmd + shift + alt - b : open -na "Google Chrome" --args --incognito

alt - g               : open -a Discord

cmd + shift - d       : open -na Ghostty --args -e /opt/homebrew/bin/lazydocker

cmd + ctrl - t        : open -na Ghostty --args --config-file="$HOME/.config/ghostty/btop.conf"

cmd + ctrl - u        : open -na Ghostty --args --config-file="$HOME/.config/ghostty/disk-usage.conf"

cmd + ctrl - e        : /opt/homebrew/bin/skhd -k "cmd + ctrl - space"

cmd + ctrl - return   : open -na Ghostty --args -e /opt/homebrew/bin/herdr

cmd + shift - c       : open -a "Google Calendar"
cmd + shift - s       : open -a "Google Maps"

cmd + shift - e       : open -a Mail
cmd + shift - y       : open -na "Google Chrome" --args --app=https://youtube.com
cmd + shift - x       : open -na "Google Chrome" --args --app=https://x.com

cmd + ctrl - a : open "x-apple.systempreferences:com.apple.Sound-Settings.extension"
cmd + ctrl - b : open "x-apple.systempreferences:com.apple.BluetoothSettings"
cmd + ctrl - w : open "x-apple.systempreferences:com.apple.wifi-settings-extension"
cmd + ctrl - d : open "x-apple.systempreferences:com.apple.Displays-Settings.extension"
cmd + ctrl - p : open "x-apple.systempreferences:com.apple.Battery-Settings.extension"
cmd + ctrl - q : open -a Calculator
cmd + ctrl - l : pmset displaysleepnow

alt - 1 [
    "google chrome" : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 1
    "brave browser" : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 1
    "safari"        : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 1
    *               ~
]
