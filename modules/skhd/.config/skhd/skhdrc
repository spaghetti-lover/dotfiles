    "google chrome" : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 5
    "brave browser" : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 5
    "safari"        : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 5
    *               ~
]
alt - 6 [
    "google chrome" : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 6
    "brave browser" : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 6
    "safari"        : "$HOME/dotfiles/modules/skhd/bin/browser-tab.sh" 6
    *               ~
