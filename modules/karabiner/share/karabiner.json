{
  "profiles": [
    {
      "complex_modifications": {
        "rules": [
          {
            "description": "Use Control as Command for Chrome clicks, keep keyboard chords",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "left_control",
                  "modifiers": {
                    "optional": ["any"]
                  }
                },
                "to": [
                  { "key_code": "left_command" }
                ],
                "to_if_other_key_pressed": [
                  {
                    "other_keys": [
                      { "any": "key_code", "modifiers": { "optional": ["any"] } }
                    ],
                    "to": [
                      { "key_code": "left_control" }
                    ]
                  }
                ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": ["^com\\.google\\.Chrome$"]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "right_control",
                  "modifiers": {
                    "optional": ["any"]
                  }
                },
                "to": [
                  { "key_code": "right_command" }
                ],
                "to_if_other_key_pressed": [
                  {
                    "other_keys": [
                      { "any": "key_code", "modifiers": { "optional": ["any"] } }
                    ],
                    "to": [
                      { "key_code": "right_control" }
                    ]
                  }
                ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": ["^com\\.google\\.Chrome$"]
                  }
                ]
              }
            ]
          },
          {
            "description": "Omarchy Super window shortcuts (Command stays Super)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "t",
                  "modifiers": {
                    "mandatory": [
                      "command"
                    ],
                    "optional": [
                      "caps_lock"
                    ]
                  }
                },
                "to": [
                  {
                    "shell_command": "/opt/homebrew/bin/yabai -m window --toggle float"
                  }
                ],
                "conditions": [
                  {
                    "type": "frontmost_application_unless",
                    "bundle_identifiers": [
                      "^com\\.tigervnc\\.tigervnc$"
